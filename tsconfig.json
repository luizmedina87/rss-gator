{
  "compilerOptions": {
    // "baseUrl": ".", // fix decprecated config
    "target": "esnext",
    // "module": "esnext", // fix decprecated config
    "module": "nodenext", // fix decprecated config
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    // "moduleResolution": "Node", // fix decprecated config
    "moduleResolution": "nodenext", // fix decprecated config
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["./src/**/*.ts"],
  "exclude": ["node_modules"]
}
